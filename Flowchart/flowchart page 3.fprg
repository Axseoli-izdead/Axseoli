<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="axseo"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-20 08:14:00 PM"/>
        <attribute name="created" value="YXhzZW87QVhTRU9MSTsyMDI2LTEwLTIwOzA3OjU5OjU2IEFNOzIzNTE="/>
        <attribute name="edited" value="YXhzZW87QVhTRU9MSTsyMDI2LTEwLTIwOzA1OjA4OjAyIFBNOzM7YXhzZW87QVhTRU9MSTsyMDI2LTEwLTE5OzEwOjEwOjQyIEFNO2ZsbG93Y2hhcnQgcGFnZSAyLmZwcmc7Njk5NA=="/>
        <attribute name="edited" value="YXhzZW87QVhTRU9MSTsyMDI2LTEwLTIwOzA4OjE0OjAwIFBNOzI7MjQ1Ng=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="J, X, V" type="String" array="False" size=""/>
            <declare name="sc1, a1, a2, a3" type="Integer" array="False" size=""/>
            <output expression="&quot;--Select--&#13;&#10;--1#Jasmine--&#13;&#10;--2#Xavier--&#13;&#10;--3#Victor--&quot;" newline="True"/>
            <input variable="sc1"/>
            <if expression="sc1 == 1">
                <then>
                    <output expression="&quot;--Intro--&#13;&#10;--Location-- The White Marble Temple, Sun-Kissed Empire.&#10;&#10;Jasmine: The sacred flame flickers, and the temple bells ring without anyone touching them. The darkness must be growing stronger.&#10;&#10;System: Welcome, Jasmine. High Priestess and princess of the Sun-Kissed Empire.&#13;&#10;&#10;Jasmine: If the corruption has reached the Whispering Forest, then its roots may already be deeper than we feared.&#13;&#10;&#10;System: Your mission for today is to purify the Dark Whispering Forest of Tundra. Use your divine abilities to cleanse the corruption and protect the land.&#10;&#10;Jasmine: May the light guide my steps. I will not allow this darkness to consume our world.&#10;System: Mission accepted. Day One begins now.&#10;&#10;--QUEST UPDATED-- Purify the Dark Whispering Forest of Tundra.&quot;" newline="True"/>
                    <output expression="&quot;The fading light&#10;At the White Marble Temple, Jasmine performs her morning prayers. Suddenly, the sacred flame turns violet.&#10;&#10;Jasmine: The sacred flame... its light is fading.&#10;&#10;--System-- Warning! Divine energy levels are unstable.&#10;&#10;An elderly priest approaches her, visibly worried.&#10;&#10;High Priest: Your Highness, the forest's corruption has reached the sacred springs. The creatures that once protected the land have become hostile.&#10;&#10;Jasmine: If the springs are corrupted, the entire region could lose its protection.&#10;&#10;High Priest: You must go to the forest and restore its sacred energy.&#10;&#10;Jasmine: Then I shall go. The light must not be allowed to disappear.&#10;&#10;--System-- New objective: Purify the corrupted sacred spring.&quot;" newline="True"/>
                    <output expression="&quot;The fallen guardian&#10;Jasmine enters the forest. The trees are covered in black vines, and the snow beneath them glows with a strange purple light.&#10;&#10;Jasmine: I can feel the pain of this place. The forest is fighting against something inside it.&#10;&#10;A large forest guardian emerges, its body covered in dark crystals.&#10;&#10;Guardian: Leave... this place...&#10;&#10;Jasmine: You're suffering. I won't hurt you unless you force me to defend myself.&#10;&#10;The guardian attacks, sending a wave of corrupted energy toward her.&#10;&#10;--System-- Enemy encountered: Corrupted Forest Guardian.&quot;" newline="True"/>
                    <output expression="&quot;--The purification trial--&#13;&#10;--System-- Choose your attack.&quot;" newline="True"/>
                    <output expression="&quot;1#Solar Smite&#13;&#10;2#Radiant barriers&#13;&#10;3#Mace combat&#13;&#10;4#Sacred Renewal&#13;&#10;5#Wrath of the Sun Goddess&#13;&#10;&quot;" newline="True"/>
                    <input variable="a1"/>
                    <output expression="&quot;-30&quot;" newline="True"/>
                    <output expression="&quot;1#Solar Smite&#13;&#10;2#Radiant barriers&#13;&#10;3#Mace combat&#13;&#10;4#Sacred Renewal&#13;&#10;5#Wrath of the Sun Goddess&#13;&#10;&quot;" newline="True"/>
                    <input variable="a2"/>
                    <output expression="&quot;-40&#13;&#10; -Dodge-&#13;&#10;You have been hit (-20)&quot;" newline="True"/>
                    <output expression="&quot;1#Solar Smite&#13;&#10;2#Radiant barriers&#13;&#10;3#Mace combat&#13;&#10;4#Sacred Renewal&#13;&#10;5#Wrath of the Sun Goddess&#13;&#10;&quot;" newline="True"/>
                    <input variable="a3"/>
                    <output expression="&quot;-30&quot;" newline="True"/>
                    <output expression="&quot;The Corrupted Forest Guardian is defeated and purified.&#10;&#10;--System-- Victory! You have overcome the Corrupted Forest Guardian.&#10;&#10;Jasmine: It's over. Please, let the light reach you once more.&#10;&#10;Jasmine raises her sacred mace. Golden light spreads through the guardian, dissolving the black crystals covering its body.&#10;&#10;Guardian: Thank you, priestess. The darkness forced me to attack those I once protected.&#10;&#10;Jasmine: Rest now. Your forest will not be abandoned.&#10;&#10;The guardian points toward a frozen spring surrounded by dark roots.&#10;&#10;Guardian: The corruption comes from beneath the earth. Even my power could not stop it.&#10;&#10;Jasmine: Then I must find its source before it spreads any further.&#10;&#10;Jasmine performs a purification ritual. The spring glows gold, and nearby plants begin to bloom again.&#10;&#10;--System--: Quest item obtained: Sacred Crystal.&#10;&#10;--System-- Day One mission completed: Purify the corrupted sacred spring.&#10;&#10;[SYSTEM]: Rewards received:&#10;- Experience: +100 XP&#10;- Gold: +50&#10;- Item: Sacred Crystal&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="sc1 == 2">
                        <then>
                            <output expression="&quot;--Intro--&#13;&#10;--Location-- The Jade Bamboo Empire, outside the Dark Forest. Xavier: The forest has been unusually silent. Even the birds have abandoned these woods.&#13;&#10;System: Welcome, Xavier. Captain of the Royal Guard of the Jade Bamboo Empire.&#10;&#10;Xavier: I've faced bandits, monsters, and enemy armies. But this silence feels like a warning.&#10;&#10;System: Reports indicate that a strange force has been spreading throughout the Dark Forest. Your mission is to investigate its source and determine whether the empire is in danger.&#13;&#10;&#10;Xavier: I'll scout the area first. If there's a threat, I'll make sure it doesn't reach our people.&#10;&#10;System: Mission accepted. Day One begins now.&#10;&#10;--QUEST UPDATED-- Investigate the Dark Forest.&quot;" newline="True"/>
                            <output expression="&quot;--The missing patrol--&#13;&#10;&#10;Xavier enters the Dark Forest after receiving reports that a royal patrol has disappeared.&#10;&#10;Xavier: Three patrols have gone missing in less than a week. Whatever is happening here, it threatens the empire.&#10;&#10;A wounded soldier stumbles out from behind a bamboo tree.&#10;&#10;Soldier: Captain... you must leave. They're not ordinary creatures.&#10;&#10;Xavier: Who attacked you? Where are the others?&#10;&#10;Soldier: Shadows... they came from the ground. Our weapons barely hurt them.&#10;&#10;The soldier hands Xavier a broken royal insignia before collapsing from exhaustion.--System-- New objective: Locate the missing patrol.&quot;" newline="True"/>
                            <output expression="&quot;--The ambush--&#13;&#10;&#10;Xavier follows a trail of broken branches and discovers abandoned weapons near a ruined bridge.&#10;&#10;Xavier: The tracks lead deeper into the forest. They were dragged toward the ruins.&#10;&#10;A shadow creature leaps from the trees.&#13;&#10;--System-- Enemy encountered: Corrupted Stalker.&#10;&#10;Xavier: So these are the creatures the soldier warned me about. Let's see how well they fight.&quot;" newline="True"/>
                            <output expression="&quot;--The first battle--&#13;&#10;--System-- Choose your attack.&quot;" newline="True"/>
                            <output expression="&quot;1#Rapid strikes&#13;&#10;2#Parry&#13;&#10;3#Royal Slash&#13;&#10;4#Counterguard&#13;&#10;5#Dragonstorm Barrage&quot;" newline="True"/>
                            <input variable="a1"/>
                            <output expression="&quot;-40&#13;&#10; -Dodge-&#13;&#10;You have been hit (-35)&quot;" newline="True"/>
                            <output expression="&quot;1#Rapid strikes&#13;&#10;2#Parry&#13;&#10;3#Royal Slash&#13;&#10;4#Counterguard&#13;&#10;5#Dragonstorm Barrage&quot;" newline="True"/>
                            <input variable="a2"/>
                            <output expression="&quot;-20&quot;" newline="True"/>
                            <output expression="&quot;1#Rapid strikes&#13;&#10;2#Parry&#13;&#10;3#Royal Slash&#13;&#10;4#Counterguard&#13;&#10;5#Dragonstorm Barrage&quot;" newline="True"/>
                            <input variable="a3"/>
                            <output expression="&quot;-40&quot;" newline="True"/>
                            <output expression="&quot;The Corrupted Stalker is defeated.&#10;&#10;[SYSTEM]: Victory! You have defeated the Corrupted Stalker.&#10;&#10;Xavier: Hah... that was tougher than I expected.&#10;&#10;Xavier examines the creature. Its dark energy begins to fade, revealing a strange black crystal embedded in its body.&#10;&#10;Xavier: So this is what's corrupting the forest.&#10;&#10;He removes the crystal carefully and places it inside a protective container.&#10;&#10;--System-- Quest item obtained: Corrupted Crystal.&#10;&#10;Xavier: I'll bring this back to the empire. Our scholars must find a way to destroy it.&#10;&#10;Suddenly, a faint voice echoes from the ruins.&#10;&#10;Mysterious Voice: The crystal is only a fragment. The source lies beneath the frozen earth.&#10;&#10;Xavier: Who said that? Show yourself!&#10;&#10;Silence follows. Xavier looks toward the northern mountains.&#10;&#10;--System-- Day One mission completed: Recover evidence of the forest corruption.&#10;&#10;--System-- Rewards received:&#10;- Experience: +100 XP&#10;- Gold: +50&#10;- Item: Corrupted Crystal&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;--Intro--&#13;&#10;--Location-- The Grand Archives of Ivory Gate, Alaria.&#13;&#10;&#10;Victor: Another quiet morning in the archives. Yet something feels different. The ancient runes are glowing brighter than usual.&#10;&#10;System: Welcome, Victor. Archduke of Alaria and master of the arcane arts.&#13;&#10;&#10;Victor: I've studied countless ancient texts, but this energy is unfamiliar. Something must have awakened.&#13;&#10;System: Your mission for today is to find the hidden cosmic map. Ancient records suggest that it contains the location of a forgotten source of power.&#13;&#10;&#10;Victor: Then I'll begin with the oldest collection. If the map exists, the archives will reveal it.&#10;&#10;[SYSTEM]: Mission accepted. Day One begins now.&#10;&#10;--QUEST UPDATED-- Find the Cosmic Map.&#13;&#10;&quot;" newline="True"/>
                            <output expression="&quot;--An unusual discovery--&#13;&#10;&#10;The Grand Archives are quiet. Victor is studying an ancient manuscript when the magical symbols on its pages suddenly begin glowing.&#13;&#10;&#13;&#10;Victor: What is this? These symbols weren't here yesterday.&#10;&#13;&#10;--SYSTEM--: Warning! An unknown magical signature has been detected.&#10;&#13;&#10;Victor: This energy... &#13;&#10;it resembles the ancient magic described in the forbidden texts.&#10;&#10;A loud crash echoes through the archive. A bookshelf slides aside, revealing a hidden staircase.&#10;&#10;Victor: A secret passage? How long has this been here? &#13;&#10;--&#10;SYSTEM-- New objective: Investigate the hidden passage.&quot;" newline="True"/>
                            <output expression="&quot;--The forbidden chamber--&#13;&#10;&#10;Victor descends the staircase and discovers a sealed chamber containing an ancient pedestal.&#10;&#10;Victor: The architecture is older than the kingdom itself. Someone deliberately concealed this place.&#10;&#10;He approaches the pedestal. A holographic map appears, showing the kingdoms of Catworld. One region is covered in dark energy.&#10;&#10;--Mysterious Voice-- At last... an heir of arcane knowledge has found the way.&#10;&#10;&#13;&#10;Victor: Who's there? Show yourself!&#10;&#10;--Mysterious Voice-- The map you seek is incomplete. Find its missing fragment before the darkness consumes the world.&#10;&#10;The hologram shatters, and a magical guardian awakens.&#13;&#10;&#10;--System-- Enemy detected: Arcane Sentinel.&quot;" newline="True"/>
                            <output expression="&quot;--Victor's first challenge--&#13;&#10;&#10;--System-- Choose your attack.&quot;" newline="True"/>
                            <output expression="&quot;1#Arcane lore&#13;&#10;2#Teleportation&#13;&#10;3#Arcane Bolt&#13;&#10;4#Cosmic Cataclysm&#13;&#10;&quot;" newline="True"/>
                            <input variable="a1"/>
                            <output expression="&quot;-50(Critical hit)&quot;" newline="True"/>
                            <output expression="&quot;1#Arcane lore&#13;&#10;2#Teleportation&#13;&#10;3#Arcane Bolt&#13;&#10;4#Cosmic Cataclysm&#13;&#10;&quot;" newline="True"/>
                            <input variable="a2"/>
                            <output expression="&quot;-20&#13;&#10; -Dodge-&#13;&#10;You have been hit (-35)&quot;" newline="True"/>
                            <output expression="&quot;1#Arcane lore&#13;&#10;2#Teleportation&#13;&#10;3#Arcane Bolt&#13;&#10;4#Cosmic Cataclysm&#13;&#10;&quot;" newline="True"/>
                            <input variable="a3"/>
                            <output expression="&quot;-30&quot;" newline="True"/>
                            <output expression="&quot;The Arcane Sentinel is defeated.&#10;&#10;[SYSTEM]: Congratulations! You have defeated the Arcane Sentinel.&#10;&#10;[SYSTEM]: The enemy has been eliminated. The hidden chamber is now safe to explore.&#10;&#10;Victor: At last. That guardian was protecting something.&#10;&#10;Victor approaches the pedestal and picks up the glowing crystal fragment.&#10;&#10;Victor: This energy... it's connected to the cosmic map. But why was it hidden here?&#10;&#10;[SYSTEM]: Quest item obtained: Cosmic Map Fragment.&#10;&#10;The fragment projects a mysterious image of an ancient structure beneath the frozen lands of Tundra.&#10;&#10;Victor: Tundra? What could possibly be hidden there?&#10;&#10;[SYSTEM]: Day One mission completed: Find the Cosmic Map Fragment.&#10;&#10;[SYSTEM]: Rewards received:&#10;- Experience: +100 XP&#10;- Gold: +50&#10;- Item: Cosmic Map Fragment&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;DAY ONE COMPLETE&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
